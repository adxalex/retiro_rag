# Credencial de Gemini. Configura solo una de las dos variables.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Proveedor alternativo no utilizado en el MVP actual.
# OPENAI_API_KEY=

# Umbral de abstencion del bloque C: si el mejor score no lo alcanza, el sistema
# se abstiene sin llamar al LLM. 0.0 desactiva la compuerta de score.
# Valor recomendado tras calibrar con el indice real:
RAG_SCORE_MINIMO=0.65

# Estacion meteorologica del Retiro (AEMET OpenData), para el saludo del asistente.
# Clave gratuita: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=
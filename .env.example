# Credencial de Gemini. Configura solo una de las dos variables.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Reintentos de embeddings cuando Gemini alcanza temporalmente su cuota.
EMBED_MAX_RETRIES=3
EMBED_RETRY_DELAY_SECONDS=60

# Proveedor alternativo no utilizado en el MVP actual.
# OPENAI_API_KEY=
